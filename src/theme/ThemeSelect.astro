---
/* ThemeSelect.astro - Header dropdown selector for Light, Dark, System */
---

<div class="relative inline-block text-left" id="theme-select-container">
  <button
    type="button"
    id="theme-menu-button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Select theme"
    class="
      inline-flex items-center gap-1.5
      px-2.5 py-1
      text-xs font-medium
      rounded-md
      border border-zinc-200 dark:border-zinc-800
      bg-zinc-50 dark:bg-zinc-900
      text-zinc-700 dark:text-zinc-300
      hover:bg-zinc-100 dark:hover:bg-zinc-800
      focus:outline-none focus:ring-2 focus:ring-blue-500/40
      transition-colors duration-150
      cursor-pointer
    "
  >
    <span id="theme-button-icon" class="text-sm">💻</span>
    <span id="theme-button-label" class="capitalize">System</span>
    <svg class="w-3 h-3 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="theme-dropdown-menu"
    class="
      hidden
      absolute right-0 mt-1.5 w-32
      rounded-lg shadow-lg
      bg-white dark:bg-zinc-900
      border border-zinc-200 dark:border-zinc-800
      py-1 z-50
      focus:outline-none
      animate-in fade-in zoom-in-95 duration-100
    "
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="theme-menu-button"
  >
    <button
      data-theme-val="light"
      class="theme-option-btn w-full flex items-center gap-2.5 px-3 py-1.5 text-xs text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-left transition-colors cursor-pointer"
      role="menuitem"
    >
      <span class="text-sm">☀️</span>
      <span class="flex-1 font-medium">Light</span>
      <span class="check-mark hidden text-blue-500 font-bold">✓</span>
    </button>
    <button
      data-theme-val="dark"
      class="theme-option-btn w-full flex items-center gap-2.5 px-3 py-1.5 text-xs text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-left transition-colors cursor-pointer"
      role="menuitem"
    >
      <span class="text-sm">🌙</span>
      <span class="flex-1 font-medium">Dark</span>
      <span class="check-mark hidden text-blue-500 font-bold">✓</span>
    </button>
    <button
      data-theme-val="system"
      class="theme-option-btn w-full flex items-center gap-2.5 px-3 py-1.5 text-xs text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-left transition-colors cursor-pointer"
      role="menuitem"
    >
      <span class="text-sm">💻</span>
      <span class="flex-1 font-medium">System</span>
      <span class="check-mark hidden text-blue-500 font-bold">✓</span>
    </button>
  </div>
</div>

<script>
  function setupThemeSelect() {
    const menuBtn = document.getElementById("theme-menu-button");
    const dropdown = document.getElementById("theme-dropdown-menu");
    const label = document.getElementById("theme-button-label");
    const icon = document.getElementById("theme-button-icon");
    const optionBtns = document.querySelectorAll<HTMLButtonElement>(".theme-option-btn");

    if (!menuBtn || !dropdown) return;

    const icons: Record<string, string> = {
      light: "☀️",
      dark: "🌙",
      system: "💻",
    };

    const getSavedTheme = () => {
      return localStorage.getItem("theme") || "system";
    };

    const applyThemePreference = (theme: string) => {
      const isDark =
        theme === "dark" ||
        (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);

      if (isDark) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      localStorage.setItem("theme", theme);
      updateUI(theme);
    };

    const updateUI = (theme: string) => {
      if (label) label.textContent = theme.charAt(0).toUpperCase() + theme.slice(1);
      if (icon) icon.textContent = icons[theme] || "💻";

      optionBtns.forEach((btn) => {
        const val = btn.dataset.themeVal;
        const check = btn.querySelector(".check-mark");
        if (val === theme) {
          btn.classList.add("text-blue-600", "dark:text-blue-400", "bg-zinc-50", "dark:bg-zinc-800/60");
          if (check) check.classList.remove("hidden");
        } else {
          btn.classList.remove("text-blue-600", "dark:text-blue-400", "bg-zinc-50", "dark:bg-zinc-800/60");
          if (check) check.classList.add("hidden");
        }
      });
    };

    // Toggle Dropdown
    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      dropdown.classList.toggle("hidden");
    });

    // Option Click
    optionBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const selectedTheme = btn.dataset.themeVal || "system";
        applyThemePreference(selectedTheme);
        dropdown.classList.add("hidden");
        menuBtn.setAttribute("aria-expanded", "false");
      });
    });

    // Close on outside click
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
        dropdown.classList.add("hidden");
        menuBtn.setAttribute("aria-expanded", "false");
      }
    });

    // Sync UI with current theme state
    updateUI(getSavedTheme());
  }

  setupThemeSelect();
  document.addEventListener("astro:after-swap", setupThemeSelect);
</script>
